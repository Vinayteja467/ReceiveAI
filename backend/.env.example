# ReceiveAI Backend Environment Configuration
PROJECT_NAME="ReceiveAI — Intelligent Receiving Inspection Manager"
API_V1_STR="/api/v1"

# Database: SQLite by default for simple zero-config local run, or PostgreSQL connection string
# Examples:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/receiveai
DATABASE_URL=sqlite:///./receiveai.db

# CORS Allowed Origins (comma separated if needed)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
